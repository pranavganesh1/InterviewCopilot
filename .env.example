# App
APP_ENV=local
LOG_LEVEL=INFO

# Postgres
POSTGRES_USER=interview
POSTGRES_PASSWORD=interview
POSTGRES_DB=interviewcopilot
DATABASE_URL=postgresql+asyncpg://interview:interview@localhost:5432/interviewcopilot

# MongoDB
MONGO_URL=mongodb://localhost:27018

# S3-compatible object storage (SeaweedFS S3 API)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=local
S3_SECRET_KEY=local

# NATS
NATS_URL=nats://localhost:4222

# LLM gateway (LiteLLM proxy)
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-local-master
GROQ_API_KEY=
GEMINI_API_KEY=

# Auth (backend-issued JWTs + Google OAuth)
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
MONGO_DB=interviewcopilot

# Docker-mode URLs (used by the containerized backend via compose overrides)
FRONTEND_URL_DOCKER=http://localhost:8080
GOOGLE_REDIRECT_URI_DOCKER=http://localhost:8080/api/v1/auth/google/callback
FEEDBACK_CATCH_UP_INTERVAL_SECONDS=300
